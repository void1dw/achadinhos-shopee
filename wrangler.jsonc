{
    "$schema":  "node_modules/wrangler/config-schema.json",
    "name":  "achadinholia",
    "compatibility_date":  "2026-10-19",
    "main":  ".svelte-kit/cloudflare/_worker.js",
    "cache":  {
                  "enabled":  true
              },
    "assets":  {
                   "binding":  "ASSETS",
                   "directory":  ".svelte-kit/cloudflare"
               },
    "d1_databases":  [
                         {
                             "database_name":  "achadinhos-candidates",
                             "migrations_dir":  "migrations",
                             "database_id":  "89fc6008-6e49-4454-b209-e7579bb3d9df",
                             "binding":  "CANDIDATES_DB"
                         }
                     ],
    "workers_dev":  true,
    "triggers":  {
                     "crons":  [
                                   "*/15 * * * *"
                               ]
                 },
    "preview_urls":  true,
    "observability":  {
                          "enabled":  true
                      }
}
